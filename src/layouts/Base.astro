---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, abs } from "../data/site";
import { graph, organization, website, webPage, breadcrumbList } from "../lib/schema";
import archivo from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import instrument from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";

interface Props {
  /** Page title without the site name. */
  title: string;
  description?: string;
  /** Use the title exactly as given (home page). */
  rawTitle?: boolean;
  noindex?: boolean;
  ogType?: "website" | "article";
  /** Path of the generated Open Graph image, e.g. "/og/approach.png". */
  ogImage?: string;
  crumbs?: { name: string; href: string }[];
  /** Extra JSON-LD nodes for this page. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = site.defaultDescription,
  rawTitle = false,
  noindex = false,
  ogType = "website",
  crumbs,
  schema = [],
} = Astro.props;

const pathname = Astro.url.pathname;
const canonical = abs(pathname);
const fullTitle = rawTitle ? title : `${title} | ${site.name}`;
const ogSlug = pathname.replace(/^\/|\/$/g, "") || "home";
const ogImage = abs(Astro.props.ogImage ?? `/og/${ogSlug}.png`);

const nodes = [
  organization(),
  website(),
  webPage({ title: fullTitle, description, href: pathname }),
  ...(crumbs && crumbs.length > 1 ? [breadcrumbList(crumbs)] : []),
  ...schema,
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#121211" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}. ${site.name}: ${site.descriptor}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Neurally Insights" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/woff2" href={archivo} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={instrument} crossorigin />

    <script type="application/ld+json" is:inline set:html={graph(nodes)} />
    <script data-goatcounter={site.goatcounter} async src="https://gc.zgo.at/count.js" is:inline></script>
  </head>
  <body>
    <a
      href="#main"
      class="bg-fg text-bg sr-only z-[60] rounded-full px-4 py-2 text-sm font-medium focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
