---
import { engagement } from "../data/engagements";

interface Props {
  problems: {
    name: string;
    description: string;
    answer: string;
    /** Engagement ids that fit, in order. Names come from the engagement data. */
    fits: string[];
    /** An extra link after the engagements, such as a use-case page. */
    more?: { label: string; href: string };
  }[];
}
const { problems } = Astro.props;
---

<ol class="border-line border-t">
  {problems.map((p, i) => (
    <li
      class="border-line grid gap-x-12 gap-y-5 border-b py-8 md:grid-cols-12 md:py-10"
      data-reveal
      style={`--i:${i % 4}`}
    >
      <div class="flex gap-5 md:col-span-6">
        <span class="text-faint text-label w-6 shrink-0 pt-[0.45em] font-mono" aria-hidden="true">
          {String(i + 1).padStart(2, "0")}
        </span>
        <div>
          <h3 class="font-display text-title">{p.name}</h3>
          <p class="text-muted mt-3 text-lg">{p.description}</p>
        </div>
      </div>
      <div class="pl-11 md:col-span-6 md:pl-0">
        <p class="text-faint text-label font-mono uppercase">What we do</p>
        <p class="mt-2 text-lg">{p.answer}</p>
        <p class="text-muted mt-4 text-sm">
          <span>Fits: </span>
          {p.fits.map((id, j) => (
            <>
              {j > 0 && <span aria-hidden="true">{" · "}</span>}
              <a class="link" href={`/services/#${id}`}>
                {engagement(id).name}
              </a>
            </>
          ))}
          {p.more && (
            <>
              <span aria-hidden="true">{" · "}</span>
              <a class="link" href={p.more.href}>
                {p.more.label}
              </a>
            </>
          )}
        </p>
      </div>
    </li>
  ))}
</ol>
