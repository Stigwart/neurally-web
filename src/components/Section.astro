---
interface Props {
  tone?: "ink" | "paper";
  size?: "md" | "sm";
  id?: string;
  labelledby?: string;
  class?: string;
  /** Draw a hairline along the top edge. */
  rule?: boolean;
}
const { tone, size = "md", id, labelledby, class: className, rule = false } = Astro.props;
---

<section
  id={id}
  data-tone={tone}
  aria-labelledby={labelledby}
  class:list={[size === "md" ? "py-section" : "py-section-sm", className]}
>
  <div class="container-page">
    {rule && (
      <div class="bg-line -mt-(--spacing-section-sm) mb-(--spacing-section-sm) h-px" data-reveal="rule" />
    )}
    <slot />
  </div>
</section>
