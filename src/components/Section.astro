---
import Glow, { type GlowColour } from "./Glow.astro";

interface Props {
  /** A soft colour glow at one edge of the section. */
  glow?: { side: "left" | "right"; colours: [GlowColour, GlowColour, ...GlowColour[]] };
  tone?: "ink" | "paper";
  size?: "md" | "sm";
  id?: string;
  labelledby?: string;
  class?: string;
}
const { tone, size = "md", id, labelledby, glow, class: className } = Astro.props;
---

<section
  id={id}
  data-tone={tone}
  aria-labelledby={labelledby}
  class:list={[size === "md" ? "py-section" : "py-section-sm", glow && "has-glow", className]}
>
  {glow && <Glow side={glow.side} colours={glow.colours} />}
  <div class="container-page">
    <slot />
  </div>
</section>
