---
interface Props {
  tone?: "ink" | "paper";
  size?: "lg" | "md" | "sm";
  id?: string;
  labelledby?: string;
  class?: string;
}
const { tone, size = "md", id, labelledby, class: className } = Astro.props;
---

<section
  id={id}
  data-tone={tone}
  aria-labelledby={labelledby}
  class:list={[{ lg: "py-section-lg", md: "py-section", sm: "py-section-sm" }[size], className]}
>
  <div class="container-page">
    <slot />
  </div>
</section>
