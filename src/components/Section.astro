---
interface Props {
  tone?: "ink" | "paper";
  size?: "md" | "sm";
  id?: string;
  labelledby?: string;
  class?: string;
}
const { tone, size = "md", id, labelledby, class: className } = Astro.props;
---

<section
  id={id}
  data-tone={tone}
  aria-labelledby={labelledby}
  class:list={[size === "md" ? "py-section" : "py-section-sm", className]}
>
  <div class="container-page">
    <slot />
  </div>
</section>
