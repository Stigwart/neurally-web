---
import { engagements } from "../data/engagements";
import Icon from "./Icon.astro";

interface Props {
  /** Engagement ids to show, in order. Defaults to the whole ladder. */
  ids?: string[];
  /** Rows expand to show outputs. When false, rows link to the services page. */
  expandable?: boolean;
  /** Open this engagement on load. */
  open?: string;
  /** Show the fee column. */
  showFee?: boolean;
}
const { ids, expandable = true, open, showFee = true } = Astro.props;
const rows = ids ? ids.map((id) => engagements.find((e) => e.id === id)!) : engagements;
const grid =
  "grid grid-cols-[2.25rem_minmax(0,1fr)_auto] items-baseline gap-x-4 md:grid-cols-[3rem_minmax(0,5fr)_minmax(0,3fr)_minmax(0,2fr)_2rem]";
---

<div class="border-line border-t">
  {rows.map((e) => {
    const head = (
      <>
        <span class="text-faint text-sm">{e.index}</span>
        <span class="font-display text-title">{e.name}</span>
        <span class="text-muted col-start-2 row-start-2 text-sm md:col-start-3 md:row-start-1 md:text-base">
          {e.length}
        </span>
        {showFee && (
          <span class="font-display text-title col-start-3 row-start-1 text-right tabular-nums md:col-start-4 md:text-left">
            {e.fee}
          </span>
        )}
      </>
    );
    return expandable ? (
      <details
        id={e.id}
        class="disclosure group border-line scroll-mt-24 border-b"
        data-stage={e.stage === "any" ? undefined : e.stage}
        open={open === e.id}
      >
        <summary
          class:list={[grid, "hover:bg-surface -mx-3 rounded-md px-3 py-6 transition-colors duration-fast"]}
        >
          {head}
          <span class="border-line-strong hidden size-8 place-items-center self-center rounded-full border md:col-start-5 transition-transform duration-base ease-out-expo group-open:rotate-45 md:grid">
            <Icon name="plus" />
          </span>
        </summary>
        <div class="grid gap-x-12 gap-y-6 pt-2 pb-9 md:grid-cols-12 md:pl-16">
          <div class="md:col-span-5">
            <p class="text-lg">{e.summary}</p>
            {e.feeNote && <p class="text-muted mt-3">{e.feeNote}</p>}
            <p class="text-muted mt-5 text-sm">
              <span class="text-faint text-sm block">Best for</span>
              {e.bestFor}
            </p>
          </div>
          <div class="md:col-span-7">
            <p class="text-faint text-sm">What you get</p>
            <ul class="mt-3">
              {e.outputs.map((o) => (
                <li class="border-line flex gap-3 border-t py-2.5 first:border-t-0">
                  <Icon name="check" class="text-stage mt-1" />
                  <span>{o}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </details>
    ) : (
      <a
        href={`/services/#${e.id}`}
        class:list={[
          grid,
          "group border-line hover:bg-surface -mx-3 rounded-md border-b px-3 py-6 transition-colors duration-fast",
        ]}
      >
        {head}
        <Icon
          name="arrow"
          class="text-faint group-hover:text-fg hidden self-center transition-[color,transform] duration-base ease-out-expo group-hover:translate-x-1 md:col-start-5 md:block"
        />
      </a>
    );
  })}
</div>
