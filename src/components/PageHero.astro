---
import Beat from "./Beat.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import { stages } from "../data/stages";

interface Props {
  crumbs: { name: string; href: string }[];
  first: string;
  second?: string | undefined;
  lede?: string;
  stage?: string;
}
const { crumbs, first, second, lede, stage } = Astro.props;
---

<section
  class="relative overflow-clip pt-10 pb-16 lg:pt-14 lg:pb-24"
  aria-labelledby="page-heading"
  data-stage={stage}
>
  <div class="page-shapes" aria-hidden="true">
    {stages.map((s, i) => (
      <span data-wash={s.id} style={`--i:${i}`} />
    ))}
  </div>
  <div class="container-page relative">
    <div class="fade-up">
      <Breadcrumbs crumbs={crumbs} />
    </div>
    <div class="mt-10 max-w-5xl lg:mt-14">
      <Beat as="h1" id="page-heading" size="display" rise first={first} second={second} />
      {lede && (
        <p class="fade-up text-muted mt-8 max-w-2xl text-xl" style="--i:3">
          {lede}
        </p>
      )}
      {Astro.slots.has("default") && (
        <div class="fade-up mt-10 flex flex-wrap items-center gap-x-6 gap-y-4" style="--i:4">
          <slot />
        </div>
      )}
    </div>
  </div>
</section>
