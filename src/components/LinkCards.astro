---
import Icon from "./Icon.astro";

interface Props {
  items: { href: string; name: string; summary: string; label?: string }[];
  headingLevel?: "h2" | "h3";
}
const { items, headingLevel: H = "h3" } = Astro.props;
---

<ul class="rows">
  {items.map((item, i) => (
    <li data-reveal style={`--i:${i % 4}`}>
      <a href={item.href} class="group row grid gap-x-8 gap-y-2 md:grid-cols-12 md:items-baseline">
        <H class="font-display text-title md:col-span-5">
          {item.label && <span class="text-faint text-sm mb-1 block font-normal">{item.label}</span>}
          {item.name}
        </H>
        <p class="text-muted md:col-span-6">{item.summary}</p>
        <Icon
          name="arrow"
          class="text-faint group-hover:text-fg hidden justify-self-end transition-[color,transform] duration-base ease-out-expo group-hover:translate-x-1 md:block"
        />
      </a>
    </li>
  ))}
</ul>
