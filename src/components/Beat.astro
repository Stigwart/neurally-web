---
/**
 * A section or page heading: a plain label that names what follows, with an
 * optional supporting line beneath it. The supporting line is ordinary text,
 * not part of the heading.
 */
interface Props {
  as?: "h1" | "h2" | "h3";
  /** The heading: a plain label, sentence case, no full stop. */
  first: string;
  /** A supporting sentence shown under the heading. */
  second?: string | undefined;
  size?: "display" | "headline" | "title";
  /** Animate the heading in on load (hero use only). */
  rise?: boolean;
  class?: string;
  id?: string;
}
const { as: Tag = "h2", first, second, size = "headline", rise = false, class: className, id } = Astro.props;
const sizes = {
  display: "text-display font-semibold",
  headline: "text-headline font-semibold",
  title: "text-title",
};
const support = "mt-4 max-w-3xl text-xl [.text-center_&]:mx-auto";
---

<Tag id={id} class:list={[sizes[size], className]}>
  {rise ? (
    <span class="line-rise" style="--i:0">
      <span>{first}</span>
    </span>
  ) : (
    first
  )}
</Tag>
{second && (
  <p class:list={[support, rise && "fade-up"]} style={rise ? "--i:2" : undefined}>
    {second}
  </p>
)}
