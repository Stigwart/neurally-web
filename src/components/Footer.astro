---
import Logo from "./Logo.astro";
import { site } from "../data/site";
import { getAllLanding, landingHref } from "../lib/content";

const groups = await getAllLanding();
const year = new Date().getFullYear();
const company = [
  { label: "Approach", href: "/approach/" },
  { label: "Services and fees", href: "/services/" },
  { label: "About Stuart", href: "/about/" },
  { label: "Insights", href: "/insights/" },
  { label: "AI maturity assessment", href: "/assessment/" },
  { label: "Contact", href: "/contact/" },
];
const linkClass = "text-muted hover:text-fg block py-1.5 text-sm transition-colors duration-fast";
const headClass = "text-faint font-mono text-label uppercase";
---

<footer data-tone="ink" class="border-line border-t pt-16 pb-10">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Logo />
        <p class="text-muted mt-5 max-w-xs text-sm">
          {site.descriptor}. UK-based and founder-led by {site.founder}.
        </p>
        <p class="mt-4 text-sm">
          <a class="link inline-block py-1" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        </p>
        <p class="text-sm">
          <a class="link inline-block py-1" href={site.linkedin} target="_blank" rel="noopener">
            Stuart on LinkedIn<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
      <nav aria-label="Footer" class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4 lg:col-span-8">
        <div>
          <p class={headClass}>Neurally</p>
          <ul class="mt-3">
            {company.map((l) => (
              <li>
                <a class={linkClass} href={l.href}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        {groups.map(({ family, entries }) => (
          <div>
            <p class={headClass}>
              <a
                href={family.base}
                class="hover:text-fg -my-1.5 inline-block py-1.5 transition-colors duration-fast"
              >
                {family.label}
              </a>
            </p>
            <ul class="mt-3">
              {entries.map((e) => (
                <li>
                  <a class={linkClass} href={landingHref(family.collection, e.id)}>
                    {e.data.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="border-line text-faint mt-14 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t pt-6 text-sm">
      <p>© {year} Neurally. Neurally is a trading name of Stuart Davis.</p>
      <p class="flex gap-6">
        <a class="hover:text-fg inline-block py-1.5 transition-colors duration-fast" href="/privacy/">
          Privacy
        </a>
        <a class="hover:text-fg inline-block py-1.5 transition-colors duration-fast" href="/rss.xml">
          RSS
        </a>
      </p>
    </div>
  </div>
</footer>
