---
import { stages } from "../data/stages";

interface Props {
  /**
   * Accessible name for the section. Visually hidden; the stages carry the content.
   * Pass false when the page shows its own visible heading with id "path-heading".
   */
  heading?: string | false;
}
const { heading = "Four stages: decide, design, deliver, embed" } = Astro.props;
---

{heading && (
  <h2 id="path-heading" class="sr-only">
    {heading}
  </h2>
)}
<ol class="grid gap-x-8 gap-y-12 md:grid-cols-2 xl:grid-cols-4">
  {stages.map((s, i) => (
    <li data-stage={s.id} class="border-stage flex flex-col border-t-2 pt-5" data-reveal style={`--i:${i}`}>
      <p class="text-sm text-muted">Stage {s.index}</p>
      <h3 class="text-title mt-2">{s.name}</h3>
      <p class="font-display text-muted mt-2 text-lg">{s.question}</p>
      <p class="mt-4">{s.summary}</p>
      <p class="text-muted mt-3 text-sm">{s.detail}</p>
      <ul class="mt-5 flex flex-wrap gap-1.5">
        {s.outputs.map((o) => (
          <li class="border-line text-muted rounded-full border px-3 py-1 text-xs">{o}</li>
        ))}
      </ul>
      <p class="text-faint mt-auto pt-5 text-sm">
        <span class="sr-only">Engagements: </span>
        {s.engagements}
      </p>
    </li>
  ))}
</ol>
