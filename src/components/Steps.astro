---
/**
 * Engagements as cards that step up in height with their length:
 * thirty minutes, a day, a week, two weeks. Each card links to its entry
 * on the services page; the free call also carries the booking button.
 */
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { engagement } from "../data/engagements";
import { site } from "../data/site";

interface Props {
  /** Engagement ids to show, shortest first. */
  ids: string[];
  /** The engagement that carries the booking button. */
  bookable?: string;
}
const { ids, bookable = "discovery-call" } = Astro.props;
const rows = ids.map((id) => engagement(id));
---

<ol class="steps">
  {rows.map((e, i) => (
    <li
      class="step-card group relative flex flex-col gap-10 rounded-2xl p-6 transition-transform duration-base ease-out-expo hover:-translate-y-1 xl:p-8"
      style={`--n:${i}`}
      data-wash={`lilac-${Math.min(i + 1, 4)}`}
      data-rise
    >
      <p class="font-display text-4xl font-semibold tracking-tight">{e.length}</p>
      <div class="mt-auto">
        <h3 class="font-display text-title">
          <a href={`/services/#${e.id}`} class="after:absolute after:inset-0 after:rounded-2xl">
            {e.name}
          </a>
        </h3>
        {e.id === bookable ? (
          <Button href={site.calendly} external class="relative z-10 mt-5" data-cta="calendly">
            Book a call
          </Button>
        ) : (
          <Icon
            name="arrow"
            class="text-muted group-hover:text-fg mt-5 transition-[color,transform] duration-base ease-out-expo group-hover:translate-x-1"
          />
        )}
      </div>
    </li>
  ))}
</ol>
