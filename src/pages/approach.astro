---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Beat from "../components/Beat.astro";
import Button from "../components/Button.astro";
import StageRow from "../components/StageRow.astro";
import Compare from "../components/Compare.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import { site } from "../data/site";
import { approachFaq } from "../data/faqs";
import { faqPage } from "../lib/schema";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Approach", href: "/approach/" },
];

const questions = [
  {
    q: "Where is the advantage?",
    a: "Which few changes could move revenue, cost, capacity or customer outcomes enough to matter, and what would each be worth?",
  },
  {
    q: "What must change?",
    a: "Which products, workflows, roles and decision rights have to be redesigned for that value to appear, and what stays with people?",
  },
  {
    q: "How will we realise it?",
    a: "Who owns each result, what gets tested first, and how will we know whether to proceed, adapt or stop?",
  },
];

const sizing = [
  { title: "The outcome expected", body: "What should improve, by how much, and for whom." },
  { title: "Where you are now", body: "Current performance, wherever evidence exists to measure it." },
  {
    title: "The assumptions",
    body: "What has to be true for the estimate to hold, stated so it can be tested.",
  },
  {
    title: "The cost of getting there",
    body: "Costs, feasibility, readiness and dependencies, including data and technology.",
  },
  {
    title: "Whether people will use it",
    body: "Adoption, quality and risk, which decide whether a working pilot becomes a working business.",
  },
  { title: "How sure we are", body: "Evidence gaps and a confidence level recorded against every estimate." },
];

const allocation = [
  {
    title: "What is the work for?",
    body: "What value is it meant to create, and for whom? Work that creates none should stop before anyone automates it.",
  },
  {
    title: "What stays with a person?",
    body: "Judgement calls, accountability, and the conversations where a customer or colleague needs a human.",
  },
  {
    title: "What does AI assist?",
    body: "Work a person still owns and signs off, done faster or better with AI alongside.",
  },
  {
    title: "What does AI take on?",
    body: "Work delegated to AI within defined controls, with a named owner and a way to review and reverse it.",
  },
  {
    title: "What changes around it?",
    body: "Roles, skills, systems, measures and governance, so the new allocation holds in practice.",
  },
];

const principles = [
  {
    without: "Start from the tools",
    with: "Business value before technology",
    detail:
      "The question is what the business could do differently, and become, now that these capabilities exist.",
  },
  {
    without: "Automate what exists",
    with: "Redesign before automation",
    detail: "Automating a poor process preserves the wrong work.",
  },
  {
    without: "Let allocation happen by default",
    with: "Allocate the work deliberately",
    detail:
      "For every workflow: what stays with a person, what AI helps with, and what AI takes on within agreed limits.",
  },
  {
    without: "Scale on enthusiasm",
    with: "Evidence before scale",
    detail: "Small, time-boxed pilots with agreed measures. Each ends in proceed, adapt or stop.",
  },
  {
    without: "Stay dependent on the adviser",
    with: "Transfer the capability",
    detail: "The outputs and the methods belong to you. The aim is a team that runs it without us.",
  },
];

const governance = [
  {
    title: "Human and AI accountability",
    body: "Every workflow redesign sets out who is accountable, what stays with a person, what is automated, and how a decision can be reviewed and reversed.",
  },
  {
    title: "FCA Consumer Duty and conduct risk",
    body: "For financial services and insurance, designs are tested against Consumer Duty outcomes and conduct risk before they reach a board.",
  },
  {
    title: "UK GDPR and the ICO",
    body: "Data use, retention and third-party processing are covered in scoping, before the build starts.",
  },
  { title: "EU AI Act", body: "Risk-category exposure is flagged early, while the design can still change." },
  {
    title: "Board oversight",
    body: "Assumptions, risks and dependencies are made as visible as the opportunity.",
  },
  {
    title: "Governance in the plan",
    body: "Mobilisation plans include an AI governance and risk view, with owners and decision gates.",
  },
];
---

<Base
  title="Our approach: Decide, Design, Deliver, Embed"
  description="How we work: three questions, four stages and an honest way of sizing AI opportunities, with governance built in. Stop after any stage and keep every output."
  crumbs={crumbs}
  schema={[faqPage(approachFaq)]}
>
  <PageHero
    crumbs={crumbs}
    first="Three questions. Four stages."
    second="One person accountable throughout."
    lede="AI is the catalyst. The work is on the business: where the advantage is, what has to change to reach it, and how the change is carried through until your own team runs it."
  >
    <Button href={site.calendly} external size="lg" data-cta="calendly">
      Book a free discovery call
    </Button>
    <Button href="/services/" variant="text">
      See engagements and fees
    </Button>
  </PageHero>

  <Section glow={{ side: "left", colours: ["decide", "lilac"] }} tone="paper" labelledby="questions-heading">
    <div data-reveal>
      <Beat id="questions-heading" first="Every engagement answers three questions." />
    </div>
    <ol class="tiles mt-12 md:grid-cols-3">
      {questions.map((item, i) => (
        <li
          class="tile"
          data-wash={["decide-tint", "design-tint", "deliver-tint"][i]}
          data-reveal
          style={`--i:${i}`}
        >
          <span class="text-faint text-sm">0{i + 1}</span>
          <h3 class="text-title mt-3">{item.q}</h3>
          <p class="text-muted mt-3">{item.a}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section labelledby="path-heading">
    <h2 id="path-heading" class="sr-only">
      Four stages: decide, design, deliver, embed
    </h2>
    <StageRow />
  </Section>

  <Section glow={{ side: "right", colours: ["design", "deliver"] }} tone="paper" labelledby="sizing-heading">
    <div class="grid gap-x-12 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-6" data-reveal>
        <Beat id="sizing-heading" first="How an opportunity is sized." />
      </div>
      <div class="text-muted space-y-4 text-lg lg:col-span-6 lg:pt-3" data-reveal style="--i:1">
        <p>
          Revenue, cost savings, released capacity and customer outcomes are kept separate. Time saved creates
          capacity. It only becomes a cash saving when spending is reduced or avoided.
        </p>
        <p>
          That distinction is where many AI business cases quietly fail, so it is made explicit from the first
          estimate.
        </p>
      </div>
    </div>
    <dl class="tiles mt-12 sm:grid-cols-2 lg:grid-cols-3">
      {sizing.map((s, i) => (
        <div class="tile" data-reveal style={`--i:${i % 3}`}>
          <dt class="font-display text-xl">{s.title}</dt>
          <dd class="text-muted mt-2">{s.body}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section glow={{ side: "left", colours: ["lilac", "decide"] }} labelledby="allocation-heading">
    <div class="grid gap-x-12 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <Beat
          id="allocation-heading"
          first="Work is allocated on purpose."
          second="Workflow by workflow, with a named owner."
        />
        <p class="text-muted mt-6 max-w-md text-lg">
          The design stage asks the same five questions of every workflow. The answers become the operating
          model: how the work gets done and who decides. They are also why people know where they stand when
          the change lands.
        </p>
      </div>
      <ol class="rows lg:col-span-7">
        {allocation.map((a, i) => (
          <li class="row grid gap-x-8 gap-y-2 md:grid-cols-5" data-reveal style={`--i:${i % 4}`}>
            <h3 class="font-display text-xl md:col-span-2">{a.title}</h3>
            <p class="text-muted md:col-span-3">{a.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <Section glow={{ side: "right", colours: ["embed", "lilac"] }} tone="paper" labelledby="governance-heading">
    <div class="max-w-3xl" data-reveal>
      <Beat
        id="governance-heading"
        first="Governance runs through every stage."
        second="It starts before anything is built."
      />
      <p class="text-muted mt-6 text-lg">
        It runs through every engagement, because the cheapest time to deal with a regulatory or
        accountability problem is before anything has been built.
      </p>
    </div>
    <ul class="tiles mt-12 sm:grid-cols-2 lg:grid-cols-3">
      {governance.map((g, i) => (
        <li class="tile" data-reveal style={`--i:${i % 3}`}>
          <h3 class="font-display text-xl">{g.title}</h3>
          <p class="text-muted mt-2">{g.body}</p>
        </li>
      ))}
    </ul>
    <div class="mt-10">
      <Button href="/use-cases/ai-governance/" variant="text">
        AI governance in practice
      </Button>
    </div>
  </Section>

  <Section glow={{ side: "left", colours: ["deliver", "design"] }} labelledby="principles-heading">
    <div data-reveal>
      <Beat id="principles-heading" first="Five principles." second="Each one replaces a habit." />
    </div>
    <div class="mt-12">
      <Compare withoutLabel="The habit" withLabel="The principle" rows={principles} />
    </div>
  </Section>

  <Section class="pt-0!" labelledby="faq-heading">
    <div class="grid gap-x-12 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <Beat id="faq-heading" first="About the approach." second="Common questions." />
      </div>
      <div class="lg:col-span-8">
        <Faq items={approachFaq} />
      </div>
    </div>
  </Section>

  <Cta />
</Base>
