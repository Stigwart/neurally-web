---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Beat from "../components/Beat.astro";
import Button from "../components/Button.astro";
import Ladder from "../components/Ladder.astro";
import Compare from "../components/Compare.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import { site } from "../data/site";
import { servicesFaq } from "../data/faqs";
import { faqPage, services } from "../lib/schema";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Services", href: "/services/" },
];

const fit = [
  "Real product, service or operational complexity",
  "Enough scope for a change in how the business operates to show up in performance",
  "Direct access to a CEO and leadership team who can act",
  "A problem one senior operator can influence across functions",
];

const wont = [
  {
    without: "Sell software or resell tools",
    with: "Advice with no product behind it",
    detail: "Your teams, or partners Neurally helps you choose and brief, do the build.",
  },
  {
    without: "Generic, off-the-shelf training",
    with: "Training on your real work",
    detail: "Built around your redesigned workflows and your governance.",
  },
  {
    without: "Recruitment or extra staffing",
    with: "A fixed term and a fixed outcome",
    detail: "Fractional and interim leadership ends when the agreed outcome is delivered.",
  },
  {
    without: "Payment by results",
    with: "Fees agreed before work starts",
    detail: "So the advice on whether to proceed, adapt or stop is never bent by how Neurally gets paid.",
  },
];
---

<Base
  title="AI advisory services and fixed fees"
  description="Nine engagements, from a free discovery call to transformation leadership. Published fixed fees: Workshop £2,500, Diagnostic £6,000, Deep Dive £12,500."
  crumbs={crumbs}
  schema={[faqPage(servicesFaq), ...services()]}
>
  <PageHero
    crumbs={crumbs}
    first="Nine engagements."
    second="The first four have the price on them."
    lede="Start with a free call. Take one fixed-fee step. Carry on only if it was worth it. Every engagement leaves you with outputs you keep, whether or not there is a next one."
  >
    <Button href={site.calendly} external size="lg" data-cta="calendly">
      Book a free discovery call
    </Button>
    <Button href="#ladder" variant="text">
      See the ladder
    </Button>
  </PageHero>

  <Section tone="paper" id="ladder" labelledby="ladder-heading" class="scroll-mt-16">
    <div class="grid gap-x-12 gap-y-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <Beat id="ladder-heading" first="The engagement ladder." second="Open any step for what you get." />
      </div>
      <p class="text-muted text-lg lg:col-span-5" data-reveal style="--i:1">
        Steps 01 to 03 have fixed fees agreed before work starts. The Workshop fee is credited in full against
        a Diagnostic or Deep Dive booked within 60 days.
      </p>
    </div>
    <div class="mt-12">
      <Ladder open="workshop" />
    </div>
  </Section>

  <Section labelledby="fit-heading">
    <div class="grid gap-x-12 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <Beat
          id="fit-heading"
          first="Where this fits best."
          second="And what an engagement needs from you."
        />
        <p class="text-muted mt-6 max-w-md text-lg">
          Neurally works with scaling and established businesses of roughly 50 to 1,000 people. An engagement
          needs an executive sponsor, access to evidence and people, a budget, and a willingness to change how
          the business operates. All of it is confirmed in scoping, before any fee.
        </p>
      </div>
      <ul class="border-line border-t lg:col-span-7">
        {fit.map((f, i) => (
          <li
            class="border-line font-display text-title flex gap-5 border-b py-6"
            data-reveal
            style={`--i:${i}`}
          >
            <span class="text-faint text-label mt-2 font-mono">0{i + 1}</span>
            {f}
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section tone="paper" labelledby="wont-heading">
    <div data-reveal>
      <Beat id="wont-heading" first="What Neurally won't do." second="And what you get because of it." />
    </div>
    <div class="mt-12">
      <Compare withoutLabel="Not offered" withLabel="What that means for you" rows={wont} />
    </div>
    <p class="text-muted mt-8 max-w-measure">
      An NDA is standard before any substantive information is shared.
    </p>
  </Section>

  <Section labelledby="faq-heading">
    <div class="grid gap-x-12 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <Beat id="faq-heading" first="Fees and scope." second="Common questions." />
      </div>
      <div class="lg:col-span-8">
        <Faq items={servicesFaq} />
      </div>
    </div>
  </Section>

  <Cta />
</Base>
