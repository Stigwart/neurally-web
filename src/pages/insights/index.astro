---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Section from "../../components/Section.astro";
import Cta from "../../components/Cta.astro";
import { getInsights, formatDate, tagSlug } from "../../lib/content";

const posts = await getInsights();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Insights", href: "/insights/" },
];
---

<Base
  title="Insights on AI strategy, operating models and governance"
  description="Practical writing from Neurally on getting AI from pilot to value: investment decisions, operating-model redesign, what stays with people, and governance."
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    first="Insights."
    second="Written for people who have to decide."
    lede="Longer pieces on the questions that come up in every engagement. No predictions about the technology. Mostly about the business around it."
  />

  <Section tone="paper" size="sm">
    <ul class="rows">
      {posts.map((post, i) => (
        <li data-reveal style={`--i:${i % 4}`} data-stage={post.data.stage}>
          <a href={`/insights/${post.id}/`} class="group row grid gap-x-8 gap-y-3 md:grid-cols-12 md:py-9">
            <p class="text-muted text-sm flex items-center gap-3 pt-2 md:col-span-3">
              <span class="bg-stage size-2 rounded-full" aria-hidden="true" />
              <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
            </p>
            <div class="md:col-span-9">
              <h2 class="text-headline">{post.data.title}</h2>
              <p class="text-muted max-w-measure mt-4 text-lg">{post.data.standfirst}</p>
              <p class="text-faint mt-4 text-sm">
                {post.data.readingMinutes} minute read · {post.data.tags.join(" · ")}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <nav aria-label="Topics" class="mt-10 flex flex-wrap items-center gap-2">
      <span class="text-muted mr-2 text-sm">Topics</span>
      {tags.map((tag) => (
        <a
          href={`/insights/tags/${tagSlug(tag)}/`}
          class="bg-surface hover:bg-paper-300 inline-flex min-h-9 items-center rounded-full px-4 text-sm transition-colors duration-fast"
        >
          {tag}
        </a>
      ))}
    </nav>
  </Section>

  <Cta />
</Base>
