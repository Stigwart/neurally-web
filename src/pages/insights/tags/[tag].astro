---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Section from "../../../components/Section.astro";
import LinkCards from "../../../components/LinkCards.astro";
import Button from "../../../components/Button.astro";
import { getInsights, tagSlug } from "../../../lib/content";

export async function getStaticPaths() {
  const posts = await getInsights();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Insights", href: "/insights/" },
  { name: tag, href: `/insights/tags/${tagSlug(tag)}/` },
];
---

<Base
  title={`${tag}: insights from Neurally`}
  description={`Our writing on ${tag.toLowerCase()}: practical pieces for leaders deciding where AI is worth the investment and how to make it pay back.`}
  crumbs={crumbs}
  ogImage="/og/insights.png"
>
  <PageHero
    crumbs={crumbs}
    first={`${tag}.`}
    second={posts.length === 1 ? "One piece so far." : `${posts.length} pieces.`}
  />
  <Section tone="paper" size="sm">
    <LinkCards
      headingLevel="h2"
      items={posts.map((p) => ({
        href: `/insights/${p.id}/`,
        name: p.data.title,
        summary: p.data.standfirst,
      }))}
    />
    <div class="mt-10">
      <Button href="/insights/" variant="text">
        All insights
      </Button>
    </div>
  </Section>
</Base>
