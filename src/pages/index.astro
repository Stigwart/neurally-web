---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Beat from "../components/Beat.astro";
import Button from "../components/Button.astro";
import ProblemPicker from "../components/ProblemPicker.astro";
import StageRow from "../components/StageRow.astro";
import Steps from "../components/Steps.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import Glow from "../components/Glow.astro";
import { site } from "../data/site";
import { homeFaq } from "../data/faqs";
import { faqPage } from "../lib/schema";
import { icons } from "../lib/icons";
import { stages } from "../data/stages";
import portrait from "../assets/stuart-davis.jpg";

const problems: Parameters<typeof ProblemPicker>[0]["problems"] = [
  {
    name: "You know AI matters, but not where to start.",
    icon: "compass",
    description: "Everyone has a view on it, and very little of it is about your business.",
    answer:
      "We cut through the hype and show where AI could genuinely improve your business, and where it won't.",
    fits: ["workshop"],
  },
  {
    name: "You've run pilots, but they haven't lived up to the promise.",
    icon: "flask",
    description: "The results are hard to see, and some tools have made the work harder.",
    answer:
      "We find what's working and what isn't, remove the complexity that's crept in, and refocus on the outcomes that matter.",
    fits: ["diagnostic", "deep-dive"],
  },
  {
    name: "You've bought the tools, but the business hasn't changed.",
    icon: "blocks",
    description:
      "The licences are in place, but the work, the roles and the decisions are the same as before.",
    answer:
      "We bring people, process and technology together. That means redesigning the work, training your teams and leading the change with you.",
    fits: ["operating-model-design", "transformation-leadership", "training"],
  },
  {
    name: "AI is everywhere in the business, but no one is in control of it.",
    icon: "shield-alert",
    description:
      "People are using tools nobody approved. Confidential and personal data is going into them, and no one can say what it all costs.",
    answer:
      "We find out where AI is really being used and what data goes into it. Then we agree which tools are approved, what data they can use, who is accountable, and how spend is kept in check.",
    fits: ["diagnostic", "deep-dive"],
    more: { label: "AI governance", href: "/use-cases/ai-governance/" },
  },
  {
    name: "AI is moving fast, and you feel you're falling behind.",
    icon: "gauge",
    description:
      "You're expected to lead the business through this, and you want to understand it well enough to do that with confidence.",
    answer:
      "One-to-one coaching for executives, so you can judge AI for yourself and lead your team through it.",
    fits: ["executive-coaching"],
  },
];
---

<Base
  title="Neurally | AI & business transformation advisory"
  rawTitle
  description="Take AI from pilot to payback. We help UK leadership teams choose where AI pays, redesign the business around it and deliver measured results."
  schema={[faqPage(homeFaq)]}
>
  <!-- Hero -->
  <section class="relative isolate overflow-clip" aria-labelledby="hero-heading" data-hero>
    <div class="hero-shapes -z-10" aria-hidden="true" data-hero-shapes>
      {stages.map((s, i) => (
        <span class="hero-shape" style={`left:${-8 + i * 26}%`} data-hero-shape>
          <span data-wash={s.id} style={`--i:${i}`} />
        </span>
      ))}
    </div>
    <div class="container-page pt-section-sm flex pb-40 min-h-[calc(100svh-4rem)] flex-col items-center justify-center text-center">
      <p class="fade-up bg-paper-200 text-muted rounded-full px-4 py-1.5 text-sm">
        For leadership teams of 50 to 1,000-person businesses
      </p>
      <h1 id="hero-heading" class="text-hero mt-8 font-semibold">
        <span class="line-rise" style="--i:1">
          <span>Take AI from pilot</span>
        </span>{" "}
        <span class="line-rise" style="--i:2">
          <span>to payback.</span>
        </span>
      </h1>
      <p class="fade-up text-muted mt-8 max-w-2xl text-xl" style="--i:4">
        We help leadership teams decide where AI is worth the investment, redesign products, processes and
        teams around it, and lead the change through to measured results.
      </p>
      <div class="fade-up mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-4" style="--i:5">
        <Button href={site.calendly} external size="lg" data-cta="calendly">
          Book a free discovery call
        </Button>
        <Button href="/assessment/" variant="text">
          Take the two-minute assessment
        </Button>
      </div>
    </div>
  </section>

  <!-- The problem -->
  <Section
    glow={{ side: "left", colours: ["decide", "lilac"] }}
    class="pt-section-sm!"
    labelledby="problem-heading"
  >
    <div class="text-center" data-rise>
      <Beat
        id="problem-heading"
        first="Common AI problems"
        second="AI isn't working for your business yet."
      />
      <p class="text-muted mx-auto mt-3 max-w-2xl text-lg">
        Most leadership teams recognise at least one of these.
      </p>
    </div>
    <div class="mt-14" data-rise>
      <ProblemPicker problems={problems} />
    </div>
    <p class="text-muted max-w-measure mx-auto mt-10 text-center text-sm" data-rise>
      You're not alone. In{" "}
      <a
        class="link"
        href="https://www.bcg.com/press/22july2026-ceos-cost-revenue-benefits-ai-struggling-scale"
        target="_blank"
        rel="noopener"
      >
        BCG's 2026 CEO survey<span class="sr-only"> (opens in a new tab)</span>
      </a>
      , most companies were running AI pilots, but only about a quarter had changed the wider business around
      them.
    </p>
  </Section>

  <!-- The path -->
  <Section class="pt-0!" labelledby="path-heading">
    <div class="text-center" data-rise>
      <Beat id="path-heading" first="How we work" />
      <p class="text-muted mx-auto mt-6 max-w-2xl text-lg">
        Every engagement starts with one question:{" "}
        <span class="text-fg">“What could this business do now that it couldn't two years ago?”</span>
      </p>
    </div>
    <div class="mt-14">
      <StageRow />
    </div>
    <div class="mt-10 text-center">
      <Button href="/approach/" variant="text">
        How the approach works
      </Button>
    </div>
  </Section>

  <!-- Ways to work together -->
  <Section glow={{ side: "right", colours: ["lilac", "design"] }} class="pt-0!" labelledby="fees-heading">
    <div class="text-center" data-rise>
      <Beat id="fees-heading" first="Engagements" />
      <p class="text-muted mx-auto mt-6 max-w-2xl text-lg">
        It starts with a conversation. From there, we can spend a day, a week or two weeks with you, depending
        on how much of the business you want to look at.
      </p>
    </div>
    <div class="mt-14">
      <Steps
        ids={["discovery-call", "workshop", "diagnostic", "deep-dive"]}
        ongoing={{
          label: "Ongoing",
          summary: "Advisory, Training, Implementation",
          href: "/services/#operating-model-design",
        }}
      />
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-6" data-rise>
      <p class="text-muted max-w-xl">
        After that, we can redesign how the work is done, support the build, lead the change, train your teams
        and coach your leaders.
      </p>
      <Button href="/services/" variant="text">
        All engagements
      </Button>
    </div>
  </Section>

  <!-- Stuart -->
  <Section class="pt-0!" labelledby="stuart-heading">
    <div class="grid items-center gap-x-10 gap-y-12 md:grid-cols-12 lg:gap-x-16">
      <div class="relative isolate md:col-span-5" data-rise>
        <Glow side="behind" colours={["deliver", "decide", "lilac"]} />
        <Image
          src={portrait}
          alt="Stuart Davis, founder of Neurally"
          widths={[320, 480, 602]}
          sizes="(min-width: 80rem) 30rem, (min-width: 48rem) 40vw, 90vw"
          class="aspect-[4/5] w-full max-w-md rounded-2xl object-cover"
        />
      </div>
      <div class="relative md:col-span-7" data-rise>
        <Beat
          id="stuart-heading"

          first="About the founder"
          second="An operator's judgement, from someone who has run the change in-house."
        />
        <p class="max-w-measure mt-6 text-lg">
          Neurally is led by Stuart Davis. He has spent more than 19 years running product, technology and
          transformation inside consumer platforms, most recently as Head of Product for Data, AI, Apps and
          Operations at Compare the Market, and before that leading banking and payments at Fresha.
        </p>
        <p class="text-muted max-w-measure mt-4 text-lg">
          The judgement you hire is the judgement applied to your business, from the board decision through to
          delivery.
        </p>
        <Button href="/about/" variant="text" class="mt-8">
          About Neurally and its founder
        </Button>
      </div>
    </div>

    <!-- Governance, in brief -->
    <div
      class="bg-surface relative mt-14 flex flex-col gap-6 rounded-2xl p-6 md:p-8 lg:flex-row lg:items-center"
      aria-labelledby="governance-heading"
      role="group"
      data-rise
    >
      <span class="problem-icon" set:html={icons["shield-check"]} />
      <div class="max-w-3xl">
        <h2 id="governance-heading" class="font-display text-title">
          Governance
        </h2>
        <p class="mt-2">Governance runs through every engagement, from scoping.</p>
        <p class="text-muted mt-2">
          A named owner for every AI-assisted decision. Consumer Duty, UK GDPR and the EU AI Act dealt with
          while the design can still change.
        </p>
      </div>
      <Button href="/use-cases/ai-governance/" variant="text" class="shrink-0 lg:ml-auto">
        AI governance in practice
      </Button>
    </div>
  </Section>

  <!-- Assessment -->
  <Section glow={{ side: "left", colours: ["embed", "lilac"] }} class="pt-0!" labelledby="assess-heading">
    <div class="bg-surface rounded-2xl px-6 py-14 text-center md:p-20" data-rise>
      <Beat
        id="assess-heading"

        first="AI maturity assessment"
        second="Not sure where you stand? Ten questions will tell you."
      />
      <p class="text-muted mx-auto mt-6 max-w-2xl text-lg">
        The AI maturity assessment takes about two minutes and places you in one of four scenarios, with your
        biggest gap and a sensible next step. It is scored in your browser. No sign-up, and nothing is stored.
      </p>
      <Button href="/assessment/" variant="secondary" size="lg" class="mt-8">
        Take the assessment
      </Button>
    </div>
  </Section>

  <!-- FAQ -->
  <Section glow={{ side: "right", colours: ["deliver", "design"] }} class="pt-0!" labelledby="faq-heading">
    <div class="grid gap-x-12 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-4" data-rise>
        <Beat id="faq-heading" first="Common questions" />
      </div>
      <div class="lg:col-span-8" data-rise>
        <Faq items={homeFaq} />
      </div>
    </div>
  </Section>

  <!-- Close: the one dark band -->
  <Cta />

  <script>
    import "../scripts/home.ts";
  </script>
</Base>
