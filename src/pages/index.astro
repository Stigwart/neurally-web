---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Beat from "../components/Beat.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import AllocationBoard from "../components/AllocationBoard.astro";
import Compare from "../components/Compare.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import CareerNote from "../components/CareerNote.astro";
import { site } from "../data/site";
import { ways } from "../data/engagements";
import { homeFaq } from "../data/faqs";
import { faqPage } from "../lib/schema";
import portrait from "../assets/stuart-davis.jpg";

const facts = [
  "Published fixed fees, from £2,500",
  "One senior operator, board to delivery",
  "No software to sell",
  "Stop after any stage, keep every output",
];

const stalls = [
  {
    without: "AI activity, no payback",
    with: "Pick the right bets",
    detail:
      "We find the few changes that will move revenue, cost or service, and put a value case behind each.",
  },
  {
    without: "New tools, same old habits",
    with: "Change the work",
    detail:
      "We redesign products, workflows and roles so the gains land, and say clearly what stays with people.",
  },
  {
    without: "No one owns the outcome",
    with: "Get it built and live",
    detail: "We lead the change with your teams and support the build hands-on, with partners where needed.",
  },
  {
    without: "Teams unsure how to use it",
    with: "A team that runs it",
    detail: "We train your people on their real work, not generic demos, and agree how results are measured.",
  },
];

const career = [
  {
    figure: "50%",
    label:
      "reduction in discovery-to-development time reported after redesigning the product lifecycle around AI",
  },
  {
    figure: "First",
    label:
      "ChatGPT app for insurance, and the company's first consumer AI assistant, launched under FCA and Consumer Duty rules",
  },
  {
    figure: "$75,000",
    label:
      "monthly revenue within six months from a machine-learning and AI subscription data product used by 2,000+ businesses",
  },
];
---

<Base
  title="Neurally | AI & business transformation advisory"
  rawTitle
  description="Take AI from pilot to payback. We help UK leadership teams choose where AI pays, redesign the business around it and deliver measured results."
  schema={[faqPage(homeFaq)]}
>
  <!-- Hero -->
  <section class="relative overflow-clip pt-14 pb-20 lg:pt-20 lg:pb-28" aria-labelledby="hero-heading">
    <div class="container-page grid items-center gap-x-12 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="fade-up text-label text-muted mb-6 font-mono uppercase">
          For leadership teams of 50 to 1,000-person businesses
        </p>
        <Beat as="h1" id="hero-heading" size="display" rise first="Take AI from pilot to payback." />
        <p class="fade-up text-muted mt-8 max-w-xl text-xl" style="--i:3">
          We help leadership teams decide where AI is worth the investment, redesign products, processes and
          teams around it, and lead the change through to measured results.
        </p>
        <div class="fade-up mt-10 flex flex-wrap items-center gap-x-6 gap-y-4" style="--i:4">
          <Button href={site.calendly} external size="lg" data-cta="calendly">
            Book a free discovery call
          </Button>
          <Button href="/assessment/" variant="text">
            Take the two-minute assessment
          </Button>
        </div>
        <ul
          class="fade-up text-muted mt-12 flex flex-col gap-2.5 text-sm sm:flex-row sm:flex-wrap sm:gap-x-7"
          style="--i:5"
        >
          {facts.map((f) => (
            <li class="flex items-center gap-2.5">
              <Icon name="check" class="text-fg" />
              {f}
            </li>
          ))}
        </ul>
      </div>
      <div class="fade-up lg:col-span-5" style="--i:2">
        <AllocationBoard />
      </div>
    </div>
  </section>

  <!-- The problem -->
  <Section tone="paper" labelledby="problem-heading">
    <div class="grid gap-x-12 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <Beat
          id="problem-heading"
          first="The technology usually isn't what's holding you back."
          second="The business around it hasn't moved."
        />
      </div>
      <div class="text-muted space-y-5 text-lg lg:col-span-5 lg:pt-3" data-reveal style="--i:1">
        <p>
          Pilots multiply and licences get bought, but the work, the roles and the decisions stay as they
          were. So the benefit stays local and nobody can point to it in the numbers.
        </p>
        <p>
          In{" "}
          <a
            class="link"
            href="https://www.bcg.com/press/22july2026-ceos-cost-revenue-benefits-ai-struggling-scale"
            target="_blank"
            rel="noopener"
          >
            BCG's 2026 CEO survey<span class="sr-only"> (opens in a new tab)</span>
          </a>
          , most companies were running AI pilots, but only about a quarter had changed the wider business
          around them.
        </p>
      </div>
    </div>
    <div class="mt-16">
      <Compare rows={stalls} />
    </div>
  </Section>

  <!-- Stuart -->
  <Section labelledby="stuart-heading">
    <div class="grid gap-x-10 gap-y-12 md:grid-cols-12 lg:gap-x-12">
      <div class="md:col-span-4" data-reveal>
        <Image
          src={portrait}
          alt="Stuart Davis, founder of Neurally"
          widths={[320, 480, 640]}
          sizes="(min-width: 64rem) 30vw, 80vw"
          class="aspect-[4/5] w-full max-w-sm rounded-lg object-cover grayscale"
        />
      </div>
      <div class="md:col-span-8">
        <div data-reveal>
          <Beat
            id="stuart-heading"
            first="An operator's judgement."
            second="From someone who has run the change in-house."
          />
          <p class="max-w-measure mt-6 text-lg">
            Neurally is led by Stuart Davis. He has spent more than 19 years running product, technology and
            transformation inside consumer platforms, most recently as Head of Product for Data, AI, Apps and
            Operations at Compare the Market, and before that leading banking and payments at Fresha.
          </p>
          <p class="text-muted max-w-measure mt-4 text-lg">
            The judgement you hire is the judgement applied to your business, from the board decision through
            to delivery.
          </p>
        </div>
        <dl class="border-line mt-10 border-t">
          {career.map((c, i) => (
            <div
              class="border-line grid gap-x-8 gap-y-1 border-b py-5 md:grid-cols-12"
              data-reveal
              style={`--i:${i}`}
            >
              <dt class="font-display text-figure md:col-span-3">{c.figure}</dt>
              <dd class="md:col-span-9 md:self-center">
                <span class="text-muted">{c.label}.</span>
                <span class="text-faint text-label mt-1 block font-mono uppercase">Before Neurally</span>
              </dd>
            </div>
          ))}
        </dl>
        <CareerNote class="mt-5" />
        <Button href="/about/" variant="secondary" class="mt-8">
          About Neurally and its founder
        </Button>
      </div>
    </div>
  </Section>

  <!-- Ways to work -->
  <Section tone="paper" labelledby="ways-heading">
    <div class="grid gap-x-12 gap-y-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <Beat id="ways-heading" first="Four ways to work together." second="The first two have fixed fees." />
      </div>
      <p class="text-muted text-lg lg:col-span-5" data-reveal style="--i:1">
        Each starts with a free 30-minute call. There is no day-rate meter running, and you can stop after any
        step and keep every output.
      </p>
    </div>
    <ul class="border-line mt-12 grid border-t md:grid-cols-2">
      {ways.map((w, i) => (
        <li class="border-line border-b md:odd:border-r" data-reveal style={`--i:${i % 2}`}>
          <a
            href={`/services/#${w.id}`}
            class="group hover:bg-surface flex h-full flex-col gap-3 p-6 transition-colors duration-fast md:p-8"
          >
            <span class="text-faint text-label font-mono">{w.index}</span>
            <span class="font-display text-title">{w.name}</span>
            <span class="text-muted">{w.summary}</span>
            <span class="mt-auto flex items-center justify-between gap-4 pt-3">
              <span class="font-display text-xl tabular-nums">{w.fee}</span>
              <Icon
                name="arrow"
                class="text-faint group-hover:text-fg transition-[color,transform] duration-base ease-out-expo group-hover:translate-x-1"
              />
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-10">
      <Button href="/services/" variant="secondary">
        Services, fees and how we work
      </Button>
    </div>
  </Section>

  <!-- FAQ -->
  <Section labelledby="faq-heading">
    <div class="grid gap-x-12 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <Beat id="faq-heading" first="Questions people ask first." />
      </div>
      <div class="lg:col-span-8">
        <Faq items={homeFaq} />
      </div>
    </div>
  </Section>

  <Cta />
</Base>
