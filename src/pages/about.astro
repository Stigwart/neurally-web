---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Section from "../components/Section.astro";
import Beat from "../components/Beat.astro";
import Button from "../components/Button.astro";
import CareerNote from "../components/CareerNote.astro";
import Cta from "../components/Cta.astro";
import { site } from "../data/site";
import { timeline, evidence } from "../data/career";
import { person } from "../lib/schema";
import portrait from "../assets/stuart-davis.jpg";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about/" },
];

const strengths = [
  {
    title: "An operator's experience",
    body: "I've built the teams, shipped the products and lived with the results. My recommendations are made for the people who will have to deliver them.",
  },
  {
    title: "Boardroom to delivery, joined up",
    body: "I can take the work from the investment case through operating-model and product design into delivery, alongside your teams. The person who made the recommendation helps you carry it out.",
  },
  {
    title: "At home where the stakes are high",
    body: "I've launched consumer AI under FCA and Consumer Duty rules. Regulation, accountability and accuracy go into the design from the first conversation, before anything reaches a board or a customer.",
  },
  {
    title: "Accountable for the numbers",
    body: "I've owned commercial targets and led a 46-person organisation. Each recommendation comes with the investment case and the measures you'll use to judge whether it paid off.",
  },
];
---

<Base
  title="About Stuart Davis, founder of Neurally"
  description="Stuart Davis has spent 19+ years leading product, technology and transformation at Compare the Market, Fresha, ClearScore and others. He now leads Neurally."
  crumbs={crumbs}
  schema={[person()]}
>
  <section class="pt-10 pb-16 lg:pt-14 lg:pb-24" aria-labelledby="page-heading">
    <div class="container-page">
      <div class="fade-up">
        <Breadcrumbs crumbs={crumbs} />
      </div>
      <div class="mt-10 grid items-end gap-x-10 gap-y-10 md:grid-cols-12 lg:mt-14 lg:gap-x-12">
        <div class="md:col-span-8">
          <h1 id="page-heading" class="text-display">
            <span class="line-rise" style="--i:0">
              <span>Stuart Davis.</span>
            </span>
            <span class="line-rise text-muted" style="--i:1">
              <span>Nineteen years on the inside of the change.</span>
            </span>
          </h1>
          <p class="fade-up text-muted mt-8 max-w-2xl text-xl" style="--i:3">
            Founder of Neurally. Formerly Head of Product (Data, AI, Apps & Ops) at Compare the Market and
            Head of Product (Banking & Payments) at Fresha.
          </p>
          <div class="fade-up mt-8 flex flex-wrap items-center gap-x-6 gap-y-4" style="--i:4">
            <Button href={site.calendly} external size="lg" data-cta="calendly">
              Book a free discovery call
            </Button>
            <Button href={site.linkedin} external variant="text">
              Stuart on LinkedIn
            </Button>
          </div>
        </div>
        <div class="fade-up md:col-span-4" style="--i:2">
          <Image
            src={portrait}
            alt="Stuart Davis, founder of Neurally"
            widths={[320, 480, 640]}
            sizes="(min-width: 64rem) 30vw, 70vw"
            loading="eager"
            class="aspect-[4/5] w-full max-w-sm rounded-lg object-cover grayscale"
          />
        </div>
      </div>
    </div>
  </section>

  <Section tone="paper" labelledby="story-heading">
    <div class="grid gap-x-12 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <Beat
          id="story-heading"
          first="Most AI advice stops at the pilot."
          second="The hard part comes after it."
        />
      </div>
      <div class="space-y-5 text-lg lg:col-span-7" data-reveal style="--i:1">
        <p>
          The hard part is deciding where AI changes the economics of your business, then reorganising
          products, workflows, roles and decision rights to capture that value, while regulators, boards,
          existing teams and live customers are all watching.
        </p>
        <p class="text-muted">
          That's the work I've spent more than nineteen years doing from the inside. Most recently I wrote
          Compare the Market's consumer AI strategy, won board backing for it and led the launch of its first
          consumer AI assistant. Before that I led payments, banking and data products at Fresha, with a
          46-person organisation.
        </p>
        <p class="text-muted">
          I bring that operator's judgement to CEOs, founders, and product and technology leaders of scaling
          and established businesses. Most often that's financial services, marketplaces and B2B SaaS.
          Professional services is a growing focus. You work with me directly, from the first leadership
          conversation through to the teams doing the work.
        </p>
      </div>
    </div>
  </Section>

  <Section labelledby="strengths-heading">
    <div data-reveal>
      <Beat id="strengths-heading" first="What I bring to an engagement." second="Four things, mainly." />
    </div>
    <ul class="border-line mt-12 grid border-t md:grid-cols-2">
      {strengths.map((s, i) => (
        <li
          class="border-line border-b py-8 md:odd:pr-10 md:even:border-l md:even:pl-10"
          data-reveal
          style={`--i:${i % 2}`}
        >
          <h3 class="text-title">{s.title}</h3>
          <p class="text-muted mt-3 text-lg">{s.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="paper" labelledby="career-heading">
    <div class="grid gap-x-12 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28" data-reveal>
          <Beat
            id="career-heading"
            first="Where the judgement comes from."
            second="Career, before Neurally."
          />
        </div>
      </div>
      <ol class="border-line border-t lg:col-span-8">
        {timeline.map((t, i) => (
          <li
            class="border-line grid gap-x-8 gap-y-2 border-b py-7 md:grid-cols-4"
            data-reveal
            style={`--i:${i % 3}`}
          >
            <p class="text-muted text-label pt-1.5 font-mono uppercase">{t.years}</p>
            <div class="md:col-span-3">
              <h3 class="font-display text-title">{t.employer}</h3>
              <p class="text-muted text-sm">{t.role}</p>
              {t.body && <p class="mt-3">{t.body}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
    <blockquote class="font-display text-headline mt-16 max-w-4xl" data-reveal>
      With Neurally, the judgement you hire is the judgement applied to your business.
    </blockquote>
  </Section>

  <Section labelledby="evidence-heading">
    <div class="max-w-3xl" data-reveal>
      <Beat
        id="evidence-heading"
        first="What the experience looks like in numbers."
        second="Career evidence, not client results."
      />
      <CareerNote class="mt-6 text-base!" />
    </div>
    <div class="mt-12 grid gap-y-14">
      {evidence.map((e) => (
        <article class="border-line grid gap-x-12 gap-y-6 border-t pt-8 lg:grid-cols-12" data-reveal>
          <div class="lg:col-span-4">
            <p class="text-faint text-label font-mono uppercase">{e.context}</p>
            <h3 class="text-title mt-3">{e.title}</h3>
            <p class="text-muted mt-3">{e.role}</p>
          </div>
          <dl class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8">
            {e.figures.map((f) => (
              <div class="border-line border-b py-5">
                <dt class="font-display text-figure tabular-nums">{f.figure}</dt>
                <dd class="text-muted mt-2">{f.label}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </Section>

  <Cta first="Talk to the person who does the work." second="Thirty minutes, free." />
</Base>
